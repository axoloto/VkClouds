#version 450

#include "define.glsl"

// Wall extents (compile-time constants)
#define ABS_WALL_X 10.0
#define ABS_WALL_Y 5.0
#define ABS_WALL_Z 3.0

// same descriptor set layout than integrateVel (2 SSBOs of same size with vec4)

// Input/output buffers
layout(std430, binding = 0) buffer VelBuffer
{
  vec4 vel[];
};

layout(std430, binding = 1) buffer PosBuffer
{
  vec4 pos[];
};

// Parameter (only timeStep needed now)
layout(push_constant) uniform Params
{
  float timeStep;
}
params;

void main()
{
  vec4 newPos = pos[ID] + vel[ID] * params.timeStep;

  // Clamp against wall bounds
  vec4 minBounds = vec4(-ABS_WALL_X, -ABS_WALL_Y, -ABS_WALL_Z, 0.0);
  vec4 maxBounds = vec4(ABS_WALL_X, ABS_WALL_Y, ABS_WALL_Z, 0.0);

  vec4 clampedNewPos = clamp(newPos, minBounds, maxBounds);
  pos[ID] = clampedNewPos;

  // If clamped != newPos (in x, y, or z), reverse and damp velocity
  bvec3 collided = notEqual(clampedNewPos.xyz, newPos.xyz);
  if (any(collided))
  {
    vel[ID] *= -0.5;
  }
}
